<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Fonts\RussoOne-Regular.ttf" />
    <None Remove="Assets\Images\battleship.png" />
    <None Remove="Assets\Images\bgImg.jpeg" />
    <None Remove="Assets\Images\boat.png" />
    <None Remove="Assets\Images\cruiser.png" />
    <None Remove="Assets\Images\destroyer.png" />
    <None Remove="Assets\Images\fire.png" />
    <None Remove="Assets\Images\miss.png" />
    <None Remove="Assets\Images\water.png" />
    <None Remove="Assets\Sounds\bg_sounds.mp3" />
    <None Remove="Assets\Sounds\cannon_shot.wav" />
    <None Remove="Assets\Sounds\click.wav" />
    <None Remove="Assets\Sounds\hit.wav" />
    <None Remove="Assets\Sounds\miss.wav" />
    <None Remove="Assets\Sounds\start_menu_music.mp3" />
    <None Remove="Assets\Sounds\sunk.wav" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Sounds\bg_sounds.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\cannon_shot.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\click.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\hit.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\miss.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\start_menu_music.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\sunk.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\RussoOne-Regular.ttf">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\battleship.png" />
    <Resource Include="Assets\Images\bgImg.jpeg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\boat.png" />
    <Resource Include="Assets\Images\cruiser.png" />
    <Resource Include="Assets\Images\destroyer.png" />
    <Resource Include="Assets\Images\fire.png" />
    <Resource Include="Assets\Images\miss.png" />
    <Resource Include="Assets\Images\water.png" />
  </ItemGroup>

</Project>
