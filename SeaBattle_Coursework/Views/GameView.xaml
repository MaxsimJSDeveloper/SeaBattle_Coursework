<UserControl x:Class="SeaBattle_Coursework.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SeaBattle_Coursework.Views"
             xmlns:vm="clr-namespace:SeaBattle_Coursework.ViewModels">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Content="⏸ PAUSE" Grid.Row="0" HorizontalAlignment="Left" Margin="20,20,0,0"
                    Width="140" Height="40" FontSize="18" Style="{StaticResource GlassButton}" 
                    Click="PauseButton_Click" />

            <Border Grid.Row="1" Background="#CC111827" BorderBrush="#40FFFFFF" 
                    BorderThickness="1" CornerRadius="15" Padding="20" Margin="20">
                <Grid ButtonBase.Click="Grid_CellClicked">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <local:BoardView DataContext="{Binding Player1Board}" Grid.Column="0" Margin="10" />
                    <local:BoardView DataContext="{Binding Player2Board}" Grid.Column="1" Margin="10" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="PauseModal" Background="#B2000B18" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Background="#CC111827" MinWidth="400" MaxWidth="500" Padding="40" 
                    CornerRadius="20" BorderBrush="#40FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="GAME PAUSED" TextAlignment="Center" FontSize="36" 
                               FontFamily="/Assets/Fonts/#Russo One" Margin="0,0,0,40" Foreground="White"/>

                    <Button Content="RESUME" FontSize="20" Width="250" Height="50" Margin="0,0,0,15" 
                            Click="ResumeButton_Click" Style="{StaticResource GlassButton}"/>

                    <Button Content="SURRENDER" FontSize="20" Width="250" Height="50" 
                            Click="BackToMenu_Click" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="GameOverModal" Background="#B2000B18" Visibility="{Binding GameOverVisibility}" Panel.ZIndex="10">
            <Border Background="#CC111827" MinWidth="450" MaxWidth="600" Padding="40" 
                    CornerRadius="20" BorderBrush="#40FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                    <TextBlock Text="{Binding GameOverMessage}" 
                               Foreground="{Binding GameOverColor}"
                               TextWrapping="Wrap" TextAlignment="Center" 
                               FontSize="36" FontFamily="/Assets/Fonts/#Russo One" 
                               Margin="0,0,0,40" />

                    <Button Content="MAIN MENU" FontSize="20" Width="250" Height="50" 
                            Click="BackToMenu_Click" Style="{StaticResource GlassButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>