<UserControl x:Class="SeaBattle_Coursework.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SeaBattle_Coursework.Views"
             xmlns:vm="clr-namespace:SeaBattle_Coursework.ViewModels">

    <Grid>
        <!-- Твоє існуюче поле бою -->
        <Grid ButtonBase.Click="Grid_CellClicked">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:BoardView DataContext="{Binding Player1Board}" Grid.Column="0" Margin="20" />
            <local:BoardView DataContext="{Binding Player2Board}" Grid.Column="1" Margin="20" />
        </Grid>

        <!-- МОДАЛЬНЕ ВІКНО -->
        <Grid x:Name="GameOverModal" Background="#B2000B18" Visibility="Collapsed">
            <Border Background="#F0F8FF" MinWidth="450" MaxWidth="600" Padding="30" 
                    CornerRadius="15" BorderBrush="#2C3E50" BorderThickness="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="GameOverText" TextWrapping="Wrap" TextAlignment="Center" 
                               FontSize="36" FontFamily="/Assets/Fonts/#Russo One" 
                               Margin="0,0,0,30" />
                    <Button Content="В ГОЛОВНЕ МЕНЮ" FontSize="20" FontFamily="/Assets/Fonts/#Russo One" 
                            Width="250" Height="50" Click="BackToMenu_Click"
                            Background="#2C3E50" Foreground="White" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>