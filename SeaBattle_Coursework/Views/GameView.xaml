<UserControl x:Class="SeaBattle_Coursework.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SeaBattle_Coursework.Views"
             xmlns:vm="clr-namespace:SeaBattle_Coursework.ViewModels">

    <!-- 2. Ділимо екран на дві рівні колонки -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 3. Дошка Гравця 1 (Ліворуч). Зверни увагу на DataContext! -->
        <local:BoardView DataContext="{Binding Player1Board}" 
                         Grid.Column="0" 
                         Margin="20" />

        <!-- 4. Дошка Гравця 2 (Праворуч) -->
        <local:BoardView DataContext="{Binding Player2Board}" 
                         Grid.Column="1" 
                         Margin="20" />
    </Grid>
</UserControl>
