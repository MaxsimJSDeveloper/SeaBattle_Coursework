<UserControl x:Class="SeaBattle_Coursework.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SeaBattle_Coursework.Views"
             xmlns:vm="clr-namespace:SeaBattle_Coursework.ViewModels">

    <Grid>
        <!-- Твоє існуюче поле бою -->
        <Grid ButtonBase.Click="Grid_CellClicked">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:BoardView DataContext="{Binding Player1Board}" Grid.Column="0" Margin="20" />
            <local:BoardView DataContext="{Binding Player2Board}" Grid.Column="1" Margin="20" />
        </Grid>

        <!-- МОДАЛЬНЕ ВІКНО (Спочатку сховане через Visibility="Collapsed") -->
        <Grid x:Name="GameOverModal" Background="#CC000000" Visibility="Collapsed">
            <Border Background="White" Width="400" Height="250" CornerRadius="15" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="GameOverText" Text="РЕЗУЛЬТАТ" FontSize="36" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,30" />
                    <Button Content="В ГОЛОВНЕ МЕНЮ" FontSize="18" FontWeight="SemiBold" 
                            Width="220" Height="50" Click="BackToMenu_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>