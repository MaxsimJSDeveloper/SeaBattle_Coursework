<UserControl x:Class="SeaBattle_Coursework.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SeaBattle_Coursework.Views"
             xmlns:vm="clr-namespace:SeaBattle_Coursework.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:BoardViewModel />
    </UserControl.DataContext>

    <Border BorderBrush="DarkBlue" BorderThickness="3" Background="LightBlue">

        <!-- 2. ItemsControl - це компонент, який вміє малювати списки. 
             Кажемо йому брати дані з нашого масиву Cells -->
        <ItemsControl ItemsSource="{Binding Cells}">

            <!-- 3. Вказуємо, що розташовувати елементи треба не в стовпчик, а у вигляді сітки 10х10 -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="10" Columns="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!-- 4. Шаблон однієї клітинки: для кожного CellViewModel буде створено таку кнопку -->
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Background="{Binding Color}" 
                            BorderBrush="DarkCyan" 
                            BorderThickness="1" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </Border>
</UserControl>
