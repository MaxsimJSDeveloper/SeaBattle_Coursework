<Window x:Class="SeaBattle_Coursework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sea Battle" 
        Height="650" Width="1000" 
        MinHeight="650" MinWidth="950" 
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/bgImg.jpeg" 
                        Stretch="UniformToFill" 
                        Opacity="0.4" />
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" HorizontalAlignment="Right" Background="#CC111827" 
                BorderBrush="#40FFFFFF" BorderThickness="1" 
                CornerRadius="0,0,0,15" Padding="15,10" Margin="0,0,20,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkMusic" Content="🎵 Music" IsChecked="True" 
                          Click="ToggleMusic_Click" Margin="10,0" FontSize="14" 
                          FontWeight="SemiBold" Foreground="White" Cursor="Hand"/>
                <CheckBox x:Name="ChkEffects" Content="🔊 Sounds" IsChecked="True" 
                          Click="ToggleEffects_Click" Margin="10,0" FontSize="14" 
                          FontWeight="SemiBold" Foreground="White" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <ContentControl x:Name="MainContent" Grid.Row="1" />
    </Grid>
</Window>
