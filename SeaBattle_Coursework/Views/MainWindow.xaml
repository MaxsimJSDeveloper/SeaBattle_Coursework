<Window x:Class="SeaBattle_Coursework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Морський Бій" 
        Height="650" Width="1000" 
        MinHeight="650" MinWidth="950" 
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/bgImg.jpeg" 
                        Stretch="UniformToFill" 
                        Opacity="0.4" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Рядок 0: Для меню звуку -->
            <RowDefinition Height="*"/>
            <!-- Рядок 1: Для ігрових екранів -->
        </Grid.RowDefinitions>

        <!-- ПАНЕЛЬ КЕРУВАННЯ ЗВУКОМ (вгорі праворуч) -->
        <Border Grid.Row="0" HorizontalAlignment="Right" Background="#F0F8FF" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkMusic" Content="🎵 Музика" IsChecked="True" 
                          Click="ToggleMusic_Click" Margin="10,0" FontSize="14" FontWeight="SemiBold" Cursor="Hand"/>
                <CheckBox x:Name="ChkEffects" Content="🔊 Звуки" IsChecked="True" 
                          Click="ToggleEffects_Click" Margin="10,0" FontSize="14" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- ОСНОВНИЙ КОНТЕНТ ГРИ -->
        <ContentControl x:Name="MainContent" Grid.Row="1" />
    </Grid>
</Window>
