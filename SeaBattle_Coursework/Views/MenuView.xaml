<UserControl x:Class="SeaBattle_Coursework.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="15" BorderBrush="#40FFFFFF" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34495E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                Background="#CC111827" BorderBrush="#40FFFFFF" 
                BorderThickness="1" CornerRadius="20" Padding="60">
            <StackPanel>
                <TextBlock Text="SEA BATTLE" FontSize="60" FontFamily="/Assets/Fonts/#Russo One" 
                           Foreground="White" Margin="0,0,0,40" HorizontalAlignment="Center"/>
                <Button Name="PlayButton" Content="PLAY" Width="250" Height="60" 
                        Click="PlayButton_Click" FontSize="28" FontFamily="/Assets/Fonts/#Russo One" 
                        Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>